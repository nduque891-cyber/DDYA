def fibonacci(n):
    if n <= 0:
        return 0

    antes = 0
    actual = 1
    i = 1

    while i < n:
        siguiente = antes + actual
        antes = actual
        actual = siguiente
        i = i + 1

    return actual


def es_primo(numero):
    if numero < 2:
        return 0

    div = 2
    while div < numero:
        if numero % div == 0:
            return 0
        div = div + 1

    return 1


def mostrar_primos(inicio, fin):
    numero = inicio
    while numero <= fin:
        if es_primo(numero):
            print(numero)
        numero = numero + 1


def suma_intermedios(inicio, fin):
    suma = 0
    numero = inicio + 1

    while numero < fin:
        suma = suma + numero
        numero = numero + 1

    return suma

